# paper2pod — Intel iGPU (oneAPI/XPU) image. Same as Dockerfile but with the
# Intel oneAPI torch + IPEX runtime so `torch.xpu` is available and the Kokoro
# backend can run on an Arc / integrated iGPU.
#
#   docker build -f Dockerfile.ipex -t paper2pod:ipex .
#   docker run -d --name paper2pod -p 8170:8170 \
#     -v /path/to/unraid/share:/library \
#     --device /dev/dri/renderD128 --device /dev/dri/card0 \
#     --group-add video \
#     -e OPENWEBUI_BASE_URL=... -e OPENWEBUI_API_KEY=... \
#     paper2pod:ipex
#
# Intel's XPU wheel index is version-coupling torch+ipex+oneapi; if the pinned
# pair no longer resolves, check https://docs.pytorch.org for the current Intel
# index used by `pip install intel-extension-for-pytorch --index-url <...>`
# and update PYTORCH_INDEX + PINNED_TORCH/ipex below together (they must match).

FROM python:3.12-slim

# Intel oneAPI wheel index (XPU/iGPU builds of torch + ipex). Keep torch and
# ipex pinned to the same pair this index serves.
ARG PYTORCH_INDEX=https://pytorch-extension.intel.com/release-whl/basic/xpu
ARG PINNED_TORCH=2.4.0
ARG PINNED_IPEX=2.4.0+xpu

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/app/.cache/huggingface \
    PAPER2POD_LIBRARY=/library \
    PAPER2POD_SETTINGS=/library/settings.json \
    HOME=/app \
    ONEAPI_DEVICE_SELECTOR=level_zero:gpu

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ffmpeg espeak-ng libsndfile1 git curl sudo \
    && curl -fsSL https://pkgs.tailscale.com/stable/debian/bookworm.gpg \
       -o /tmp/tailscale.gpg \
    && install -o root -g root -m 644 /tmp/tailscale.gpg \
       /usr/share/keyrings/tailscale-archive-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/tailscale-archive-keyring.gpg] \
https://pkgs.tailscale.com/stable/debian bookworm main" \
       > /etc/apt/sources.list.d/tailscale.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends tailscale \
    # Intel oneAPI runtime: Level Zero GPU loader + OpenCL ICD runtime.
    && apt-get install -y --no-install-recommends intel-opencl-icd \
    && rm -rf /var/lib/apt/lists/* /tmp/tailscale.gpg

# Intel XPU torch build first (overrides the CPU wheel during `pip install .`),
# then IPEX. Must precede the app install so pyproject's torch>=2.1 is satisfied
# by this wheel, not re-fetched from PyPI.
COPY pyproject.toml README.md config.example.yaml ./
COPY src ./src
RUN pip install torch==${PINNED_TORCH} --index-url ${PYTORCH_INDEX} \
    && pip install intel-extension-for-pytorch==${PINNED_IPEX} --index-url ${PYTORCH_INDEX} \
    && pip install .

RUN python - <<'EOF'
import torch
print("torch", torch.__version__, "xpu available:", torch.xpu.is_available())
from paper2pod.tts.kokoro_backend import KokoroBackend
b = KokoroBackend(device="xpu")
for v in ("af_heart", "bm_george"):
    b.synthesize("Hello from paper2pod.", v, 1.0)
print("Kokoro warmed on xpu")
EOF

EXPOSE 8170
CMD ["paper2pod-server"]